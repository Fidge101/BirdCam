# ── Camera ────────────────────────────────────────────────────────────────────
# IP address of the Tapo C120 on your local network.
# Find it in the Tapo app (Device Info) or your router's DHCP client list.
CAMERA_IP=192.168.1.100

# RTSP credentials — set these under Tapo app > Camera Settings >
# Advanced Settings > Camera Account (NOT your Tapo account password).
CAMERA_USER=admin
CAMERA_PASS=your_rtsp_password_here

# ── Capture ───────────────────────────────────────────────────────────────────
# How often (seconds) to grab and save a frame. 60 = once per minute.
CAPTURE_INTERVAL_SECONDS=60

# Directory where timestamped frame JPEGs are stored.
FRAME_STORE_DIR=./frames/

# Maximum number of frames to keep. Oldest are deleted when this is exceeded.
MAX_FRAMES=100

# ── Timelapse ─────────────────────────────────────────────────────────────────
# Output path for the generated timelapse contact sheet JPEG.
TIMELAPSE_OUTPUT_PATH=./timelapse.jpg

# ── Web dashboard ─────────────────────────────────────────────────────────────
# Port for the Flask web server. Access at http://<pi-hostname>.local:PORT
PORT=5000

# JPEG compression quality for the MJPEG stream (0–100). Lower = faster/smaller.
STREAM_QUALITY=80
